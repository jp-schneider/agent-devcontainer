**/*.env
.claude-docker/*
.claude/settings.local.json
.claude/scratchpad/*/outputs/
.devcontainer/.generated/
CLAUDE.local.md
# Python venvs: a host-side .venv, and the uv toolchain's per-worktree links (symlinks, hence no
# trailing slash: git treats a symlink as a file, so ".venv-*.ct/" would not match)
.venv
.venv-*.ct
# node toolchain: per-package node_modules (in the container, a named volume mounted there; on the
# host, an empty mount point created by toolchains/node/init-host.sh)
node_modules/
