{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.kdbx)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.git-credentials)",
      "Read(**/.htpasswd)",
      "Read(**/.aws/credentials)",
      "Read(**/.aws/config)",
      "Read(**/.docker/config.json)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.toml)",
      "Read(**/*.tfvars)",
      "Read(**/terraform.tfstate)",
      "Read(**/terraform.tfstate.backup)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.kdbx)",
      "Edit(**/id_rsa)",
      "Edit(**/id_dsa)",
      "Edit(**/id_ecdsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.git-credentials)",
      "Edit(**/.htpasswd)",
      "Edit(**/.aws/credentials)",
      "Edit(**/.aws/config)",
      "Edit(**/.docker/config.json)",
      "Edit(**/credentials)",
      "Edit(**/credentials.json)",
      "Edit(**/secrets.json)",
      "Edit(**/secrets.yaml)",
      "Edit(**/secrets.yml)",
      "Edit(**/secrets.toml)",
      "Edit(**/*.tfvars)",
      "Edit(**/terraform.tfstate)",
      "Edit(**/terraform.tfstate.backup)"
    ]
  }
}
