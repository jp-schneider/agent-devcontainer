{
  "name": "Claude Code · latex",
  "dockerComposeFile": [
    "../shared/compose.core.yml",
    "../shared/toolchains/latex/compose.yml",
    "../compose.project.yml",
    "../.generated/compose.host.yml",
    "../.generated/compose.protect.yml"
  ],
  "service": "claude-code",
  "workspaceFolder": "/app",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "remoteEnv": {
    // First layer of defence – VS Code re-injects some of these, so the
    // security-harden.sh script sourced from .bashrc is the real safeguard.
    "SSH_AUTH_SOCK": "",
    "GPG_AGENT_INFO": "",
    "BROWSER": "",
    "VSCODE_IPC_HOOK_CLI": null,
    "VSCODE_GIT_IPC_HANDLE": null,
    "GIT_ASKPASS": null,
    "VSCODE_GIT_ASKPASS_MAIN": null,
    "VSCODE_GIT_ASKPASS_NODE": null,
    "VSCODE_GIT_ASKPASS_EXTRA_ARGS": null,
    "REMOTE_CONTAINERS_IPC": null,
    "REMOTE_CONTAINERS_SOCKETS": null,
    "REMOTE_CONTAINERS_DISPLAY_SOCK": null,
    "WAYLAND_DISPLAY": null
  },
  // latex toolchain: upstream TeX Live in a shared volume, installed on first start (see
  // shared/toolchains/latex/post-start.sh); project packages in .devcontainer/tex-packages.txt
  "initializeCommand": ["bash", ".devcontainer/shared/initialize.sh", "latex", "latex"],
  // postStartCommand: toolchain hooks via shared/post-start.sh (none for latex), then clean up sockets
  // created before VS Code attaches
  "postStartCommand": "bash /app/.devcontainer/shared/post-start.sh; bash /app/.devcontainer/shared/socket-cleanup.sh --once",
  // The same cleanup keeps running in the Docker Compose command (VS Code recreates the sockets on
  // every attach) – postAttachCommand is unreliable for background processes due to VS Code's
  // cgroup-based lifecycle cleanup.
  // postAttachCommand: remove credential helpers from the git config VS Code may copy in at attach
  "postAttachCommand": "bash /app/.devcontainer/shared/post-attach.sh",
  "customizations": {
    "vscode": {
      "settings": {
        // No host credentials for git: GitHub login (Source Control, Git Graph), askpass in the
        // terminal. The dev.containers.* settings (copyGitConfig, gitCredentialHelperConfigLocation,
        // dockerCredentialHelper) only work as host user settings, not here: see docs/customizing.md,
        // "How do I commit and push?"; shared/post-attach.sh warns while they are missing.
        "github.gitAuthentication": false,
        "git.terminalAuthentication": false,
        // Container only (not .vscode/settings.json, which the host shares): hide files that are
        // masked here (empty, read-only; see shared/mask-patterns.txt). Cosmetic; globs approximate
        // the regexes and cannot exclude container.env from *.env, so *.env is not listed.
        "files.exclude": {
          "**/.git": true, "**/.svn": true, "**/.hg": true, "**/CVS": true, "**/.DS_Store": true, "**/Thumbs.db": true,
          "**/.env": true, "**/.env.*": true,
          "**/*.pem": true, "**/*.key": true, "**/*.p12": true, "**/*.pfx": true, "**/*.jks": true, "**/*.keystore": true, "**/*.kdbx": true,
          "**/id_rsa": true, "**/id_dsa": true, "**/id_ecdsa": true, "**/id_ed25519": true,
          "**/.netrc": true, "**/.npmrc": true, "**/.pypirc": true, "**/.git-credentials": true, "**/.htpasswd": true,
          "**/.aws/credentials": true, "**/.aws/config": true, "**/.docker/config.json": true,
          "**/credentials": true, "**/credentials.{json,yaml,yml,toml,ini,txt,cfg,conf}": true,
          "**/secret{,s}": true, "**/secret{,s}.{json,yaml,yml,toml,ini,txt,cfg,conf}": true,
          "**/*.tfvars": true, "**/terraform.tfstate{,.backup}": true
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.automationProfile.linux": {
          "path": "/bin/bash"
        },
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },
        // LaTeX Workshop: builds with latexmk on save (its default recipe, no -shell-escape) and
        // shows the PDF in a VS Code tab (SyncTeX: Ctrl+Alt+J / Ctrl+click), no display needed.
        // PDF and build files go to output/ next to the .tex file
        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.latex.outDir": "%DIR%/output",
        "latex-workshop.formatting.latex": "latexindent"
      },
      "extensions": [
        "anthropic.claude-code",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "augustocdias.tasks-shell-input",
        "nuriyev.claude-code-katex",
        "james-yu.latex-workshop"
      ]
    }
  }
}
